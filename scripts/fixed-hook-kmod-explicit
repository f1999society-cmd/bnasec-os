#!/bin/sh
# BNAsec: explicit kmod hook (replaces the stock fragile one in fakechroot
# builds). Copies the kmod multi-call binary, its direct libs, modprobe.d and
# creates the compatibility symlinks — deterministically.
PREREQ=""
prereq() { echo "$PREREQ"; }
case "$1" in
  prereq) prereq; exit 0 ;;
esac

set -e
. /usr/share/initramfs-tools/hook-functions

# the multi-call binary + its SONAME libs (chroot-relative ldd)
copy_exec /usr/bin/kmod
mkdir -p "${DESTDIR}/usr/lib/x86_64-linux-gnu"
for lib in libz.so.1 liblzma.so.5 libzstd.so.1 libcrypto.so.3 libc.so.6; do
  p="/usr/lib/x86_64-linux-gnu/$lib"
  if [ -e "$p" ] && [ ! -e "${DESTDIR}$p" ]; then
    cp -fL "$p" "${DESTDIR}$p"
  fi
done

# compatibility symlinks (relative, valid inside the initramfs)
mkdir -p "${DESTDIR}/usr/sbin"
for name in modprobe rmmod insmod lsmod depmod modinfo insmod.static; do
  src="/usr/sbin/$name"
  if [ -e "$src" ] || [ -L "$src" ]; then
    ln -sf kmod "${DESTDIR}/usr/sbin/$name"
  fi
done

# module configuration
mkdir -p "${DESTDIR}/usr/lib/modprobe.d/"
if [ -d /usr/lib/modprobe.d ]; then
  for f in /usr/lib/modprobe.d/*.conf; do
    [ -e "$f" ] && cp -f "$f" "${DESTDIR}/usr/lib/modprobe.d/"
  done
fi

exit 0
